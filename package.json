{
  "name": "sentinel-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "test": "vitest run",
    "db:migrate": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs src/db/migrate.ts",
    "owner:create": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs src/cli.ts owner:create"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "fastify": "^5.0.0",
    "mysql2": "^3.11.0",
    "pino": "^9.3.0",
    "tsx": "^4.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
